# Contact form (src/app/api/contact/route.ts) sends mail through Resend.
# Without these the form falls back to opening the visitor's email app.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Ilynt Labs <noreply@mail.ilyntlabs.com>"
CONTACT_FROM_EMAIL=
# Defaults to bilal@ilyntlabs.com
CONTACT_TO_EMAIL=
